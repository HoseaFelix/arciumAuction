# Copy this file to .env.local for local development.
# Keep real keys and paid RPC URLs out of git.

# Public browser-facing Solana RPC endpoint.
# A dedicated devnet RPC from Helius, QuickNode, Triton, etc. is strongly recommended.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Server-side RPC endpoint used by Next API routes.
# Usually set this to the same provider as NEXT_PUBLIC_SOLANA_RPC_URL.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Your deployed auction program id.
# Replace this after you deploy your own copy of the Solana/Arcium program.
NEXT_PUBLIC_PROGRAM_ID=ByASCyH6YjXWa9KS1qdGVGxH5vgQFAC4Aauh4Z89ut9t
PROGRAM_ID=ByASCyH6YjXWa9KS1qdGVGxH5vgQFAC4Aauh4Z89ut9t

# Arcium cluster offset.
# Devnet is currently 456. Mainnet-alpha is different; do not use this app on mainnet until tested.
NEXT_PUBLIC_ARCIUM_CLUSTER_OFFSET=456
CLUSTER_OFFSET=456

# API bases. Leave these relative unless you intentionally run a separate backend.
NEXT_PUBLIC_ENCRYPTION_API_BASE_URL=/api/encryption
NEXT_PUBLIC_AUCTIONS_API_BASE_URL=/api/auctions

# Optional: restrict the older Express API if you choose to run api/server.js.
# CORS_ORIGINS=http://localhost:3000
# PORT=4000
